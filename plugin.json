{
  "id": "qishui",
  "name": "汽水音乐",
  "version": "0.2.1",
  "minAppVersion": "0.1.7",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "api.qishui.com",
      "api5-lq.qishui.com",
      "*.qishui.com"
    ],
    "process": [
      "node",
      "/opt/homebrew/bin/node",
      "/usr/local/bin/node",
      "ffmpeg",
      "/opt/homebrew/bin/ffmpeg",
      "/usr/local/bin/ffmpeg"
    ]
  },
  "navigation": [
    { "builtin": "home" },
    { "builtin": "liked" }
  ]
}
