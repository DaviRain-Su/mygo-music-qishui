{
  "id": "qishui",
  "name": "汽水音乐",
  "version": "0.4.3",
  "minAppVersion": "0.1.7",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "api.qishui.com",
      "api5-lq.qishui.com",
      "*.qishui.com"
    ],
    "process": [
      "node",
      "/opt/homebrew/bin/node",
      "/usr/local/bin/node",
      "ffmpeg",
      "/opt/homebrew/bin/ffmpeg",
      "/usr/local/bin/ffmpeg"
    ]
  },
  "navigation": [
    {
      "builtin": "home",
      "title": "首页",
      "icon": "home"
    },
    {
      "page": "discover",
      "title": "发现",
      "icon": "star"
    },
    {
      "page": "charts",
      "title": "榜单",
      "icon": "chart"
    },
    {
      "builtin": "liked",
      "title": "我喜欢",
      "icon": "heart"
    },
    {
      "page": "history",
      "title": "最近播放",
      "icon": "calendar"
    },
    {
      "builtin": "stations",
      "title": "情景电台",
      "icon": "radio"
    },
    {
      "builtin": "savedAlbums",
      "title": "收藏专辑",
      "icon": "album"
    }
  ]
}
