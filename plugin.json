{
  "id": "qishui",
  "name": "汽水音乐",
  "version": "0.5.2",
  "minAppVersion": "0.1.22",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "qishui.com",
      "*.qishui.com",
      "beta-luna.douyin.com"
    ],
    "process": [
      "bin/qishui-helper-*"
    ]
  },
  "navigation": [
    {
      "builtin": "home",
      "title": "首页",
      "icon": "home"
    },
    {
      "builtin": "stations",
      "title": "为你推荐",
      "icon": "radio"
    },
    {
      "page": "listening-modes",
      "title": "听歌模式",
      "icon": "radio"
    },
    {
      "page": "discover",
      "title": "发现",
      "icon": "star"
    },
    {
      "page": "charts",
      "title": "榜单",
      "icon": "chart"
    },
    {
      "builtin": "liked",
      "title": "我喜欢",
      "icon": "heart"
    },
    {
      "page": "history",
      "title": "最近播放",
      "icon": "calendar"
    },
    {
      "builtin": "savedAlbums",
      "title": "收藏专辑",
      "icon": "album"
    }
  ]
}
